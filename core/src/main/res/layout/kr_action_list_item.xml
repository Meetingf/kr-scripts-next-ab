<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="16dp"
    android:paddingStart="4dp">

    <ImageView
        android:id="@id/kr_shortcut_icon"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:src="@drawable/baseline_shortcut_24"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/kr_shortcut_color" />

    <ImageView
        android:id="@id/kr_icon"
        android:layout_width="35dp"
        android:layout_height="33dp"
        android:layout_marginStart="12dp"
        android:padding="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@id/kr_title"
        style="@style/TextAppearance.Material3.TitleSmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/kr_desc"
        app:layout_constraintEnd_toStartOf="@+id/kr_widget"
        app:layout_constraintStart_toEndOf="@+id/kr_icon"
        app:layout_constraintTop_toTopOf="@+id/kr_icon"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@id/kr_desc"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toTopOf="@+id/kr_summary"
        app:layout_constraintEnd_toStartOf="@+id/kr_widget"
        app:layout_constraintStart_toEndOf="@+id/kr_icon"
        app:layout_constraintTop_toBottomOf="@+id/kr_title" />

    <TextView
        android:id="@id/kr_summary"
        style="@style/TextAppearance.Material3.BodySmall"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:textColor="?android:colorAccent"
        app:layout_constraintBottom_toBottomOf="@+id/kr_icon"
        app:layout_constraintEnd_toStartOf="@+id/kr_widget"
        app:layout_constraintStart_toEndOf="@+id/kr_icon"
        app:layout_constraintTop_toBottomOf="@+id/kr_desc" />

    <ImageView
        android:id="@id/kr_widget"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginEnd="16dp"
        android:alpha="0.8"
        android:padding="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?android:colorAccent" />

</androidx.constraintlayout.widget.ConstraintLayout>