<?xml version="1.0" encoding="UTF-8" ?>
<config>
    <group>
        <picker>
            <title>单选</title>
            <summary sh="echo -n '当前选中：'; getprop kr.picker.1" />
            <options>
                <option value="1">选项 1</option>
                <option value="2">选项 2</option>
            </options>
            <get>getprop kr.picker.1</get>
            <set>setprop kr.picker.1 $state</set>
        </picker>
        <picker options-sh="echo 'a|选项A'; echo 'b|选项B'">
            <title>单选（由脚本输出选项）</title>
            <summary sh="echo -n '当前选中：'; getprop kr.picker.2" />
            <get>getprop kr.picker.2</get>
            <set>setprop kr.picker.2 "$state"</set>
        </picker>

        <picker multiple="multiple" options-sh="echo 'a|选项A'; echo 'b|选项B'" separator="|">
            <title>多选</title>
            <get>getprop kr.picker.3</get>
            <summary sh="echo -n '当前选中：'; getprop kr.picker.3" />
            <set>setprop kr.picker.3 "$state"</set>
        </picker>
    </group>

    <group title="自定义多选分隔符">
        <picker multiple="multiple" separator=",">
            <title>隐藏状态栏图标</title>
            <desc>设置隐藏的状态栏图标</desc>
            <options>
                <option value="mobile">手机信号</option>
                <option value="volte">VoLTE</option>
                <option value="airplane">飞行模式</option>
                <option value="location">定位图标</option>
                <option value="nfc">NFC</option>
                <option value="vpn">VPN</option>
                <option value="bluetooth">蓝牙</option>
                <option value="volume">音量/静音</option>
                <option value="zen">勿扰模式</option>
                <option value="alarm_clock">闹钟</option>
                <option value="headset">耳机</option>
                <option value="ime">输入法</option>
            </options>
            <get>
                settings get secure icon_blacklist
            </get>
            <set>
                settings put secure icon_blacklist "$state"
            </set>
        </picker>
    </group>
</config>