<?xml version="1.0" encoding="UTF-8" ?>
<config>
    <group>
        <text>
            <slices>
                <slice>默认情况下，一个action、picker、switch的脚本执行完后，只会刷新自身的界面显示。</slice>
                <slice break="true">如果你需要关联刷新其它节点，则需要参考这个例子</slice>
            </slices>
        </text>
    </group>

    <group title="刷新整个页面">
        <action reload="true" shell="hidden">
            <title>reload 属性测试</title>
            <desc>会刷新当前界面喵</desc>
            <script>
                setprop kr.time.date "$(date)"
            </script>
        </action>
        <text>
            <title>kr.time.date 当前值</title>
            <desc sh="getprop kr.time.date" />
        </text>
        <text>
            <slices>
                <slice>reload-page="true"、reload="true"、reload="page"均有着同样的效果。</slice>
                <slice break="true">但为了保持一致和简单明了，建议用reload="page"</slice>
            </slices>
        </text>
    </group>

    <group title="指定节点刷新" id="group-1">
        <text id="node-1">
            <title>我是个要被刷新的节点</title>
            <summary sh="getprop kr.time.date" />
        </text>
        <action id="@node-2">
            <title>我也是要被刷新的节点</title>
            <summary sh="getprop kr.time.date" />
        </action>

        <action reload="node-1" shell="hidden">
            <title>刷新第一项</title>
            <desc>执行以刷新 node-1</desc>
            <script>
                setprop kr.time.date "$(date)"
            </script>
        </action>

        <action reload="@node-2" shell="hidden">
            <title>刷新第二项</title>
            <desc>执行以刷新 @node-2</desc>
            <script>
                setprop kr.time.date "$(date)"
            </script>
        </action>
    </group>

    <group title="整组刷新">
        <action reload="group-1" shell="hidden">
            <title>reload 属性测试</title>
            <desc>执行以刷新上面一组</desc>
            <script>
                setprop kr.time.date "$(date)~"
            </script>
        </action>
    </group>

    <group title="其它">
        <text>
            <title>其它说明</title>
            <slices>
                <slice>以 @ 为开头的 id, 则只用作唯一标识，而不允许长按添加快捷方式, 如 @node-2</slice>
            </slices>
        </text>
    </group>
</config>