            <title>圆角矩形</title>
        </action>
        <action clip="circle" icon="icons/wifi.png">
            <title>圆形</title>
        </action>
    </group>

    <group title="网络图片">
        <action id="web_ic" clip="30" icon="https://cdn-icons-png.flaticon.com/128/6422/6422199.png">
