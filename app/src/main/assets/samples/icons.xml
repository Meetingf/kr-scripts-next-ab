<config>
    <group title="裁剪">
        <!--    clip 标签用来制定该项 icon 的圆角大小-->
        <action clip="30" icon="icons/wifi.png">
            <title>圆角矩形</title>
        </action>
        <action clip="circle" icon="icons/wifi.png">
            <title>圆形</title>
        </action>
    </group>

    <group title="网络图片">
        <action clip="30" icon="https://cdn-icons-png.flaticon.com/128/6422/6422199.png">
            <title>图标喵</title>
        </action>
        <image>
            <src>https://www.dmoe.cc/random.php</src>
            <!--所有内容都在里面-->
            <scale>centerInside</scale>
            <clip>64</clip>
        </image>
        <image>
            <src>https://www.dmoe.cc/random.php</src>
            <!--裁剪到匹配高度-->
            <scale>centerCrop</scale>
            <height>2560</height>
            <clip>128</clip>
        </image>
    </group>
</config>