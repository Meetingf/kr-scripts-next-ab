<?xml version="1.0" encoding="UTF-8" ?>
<nav title="主页">

    <menu>
        <option type="default" id="a" auto-off="true">自定义 1</option>
        <option type="default" id="b">自定义 2</option>
        <option type="refresh">刷新界面</option>
        <option type="finish">关闭页面</option>
        <option type="file">选择文件</option>
        <handler>
            echo '此脚本的作用是处理菜单点击事件'
            echo '执行时PIO会告诉你哪个菜单项被点击，就像Picker的 set 一样'
            echo ''
            echo '点击的菜单项' $menu_id
            echo ''
            echo '选择的文件' $file
            echo ''
        </handler>
    </menu>

    <group title="运行环境测试">
        <page config="samples/env/env.xml" title="环境测试">
            <resource dir="file:///android_asset/samples/env" />
        </page>
    </group>

    <group title="功能节点">
        <page config="samples/action.xml" title="Action（动作）" />
        <page config="samples/switch.xml" title="Switch（开关）" />
        <page config="samples/picker.xml" title="Picker（选择）" />
        <page config="samples/page.xml" title="Page（子页面）" />
    </group>

    <group title="文字节点">
        <page config="samples/text.xml" title="Text（文字节点）" />
    </group>

    <group title="其它">
        <page config="samples/shortcut.xml" title="快捷方式" />
        <page config="samples/reload.xml" title="节点刷新" />
        <page config="samples/bg_task/bg_task.xml" title="后台任务" />
        <page config="samples/limit.xml" title="功能限制" />
        <action title="控制进度条">
            <script>
                echo progress:[0/100]
                echo 第一步
                sleep 1
                echo progress:[13/100]
                echo 第二步
                sleep 1
                echo progress:[66/100]
                echo 第三步
                sleep 1
                echo progress:[85/100]
                echo 最后一步
                sleep 1
                echo 好了
                echo progress:[100/100]
            </script>
        </action>
    </group>

    <group title="Web引擎">
        <page config="samples/web.xml" title="网页引擎测试" />
    </group>

</nav>